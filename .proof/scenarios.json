{
  "repository": "brunnojob/swift-offshore-commissioning-evidence",
  "inputs": [
    ".proof/scenarios.json",
    "examples/input.txt"
  ],
  "cases": [
    {
      "name": "swiftc Sources/main.swift -o app && ./app --self-test && ./app < examples/input.txt",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "swiftc Sources/main.swift -o app && ./app --self-test && ./app < examples/input.txt"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "Application demonstration with checked output",
      "argv": [
        "./app"
      ],
      "input": "examples/input.txt",
      "contains": [
        "OUT_OF_RANGE",
        "BLOCKED:valve-stroke"
      ]
    },
    {
      "name": "Reject an empty capture",
      "argv": [
        "./app"
      ],
      "stdin": "",
      "exit": 2
    },
    {
      "name": "Reject malformed input",
      "argv": [
        "./app"
      ],
      "stdin": "broken,input\n",
      "exit": 2
    },
    {
      "name": "Reject unsupported invocation",
      "argv": [
        "./app",
        "--unsupported"
      ],
      "exit": 2,
      "contains": [
        "arguments"
      ]
    },
    {
      "name": "Reject an oversized input record",
      "argv": [
        "./app"
      ],
      "stdin": "\n",
      "exit": 2,
      "contains": [
        "record too large"
      ]
    }
  ]
}
